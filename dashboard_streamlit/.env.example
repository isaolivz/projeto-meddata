# Copie este arquivo para ".env" e preencha os valores reais.
# O ".env" nunca deve ser commitado (contém credenciais).

# --- Oracle Autonomous Database (MedData) ---
# Wallet já está em ./wallet (Wallet_meddataadb2.zip extraída).
# ORACLE_DSN deve ser um dos aliases definidos em wallet/tnsnames.ora,
# por exemplo: meddataadb_high, meddataadb_medium, meddataadb_low
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=meddataadb_high
ORACLE_WALLET_DIR=./wallet
ORACLE_WALLET_PASSWORD=

# --- Select AI ---
# Nome do profile já criado no banco via DBMS_CLOUD_AI.CREATE_PROFILE,
# apontando para um modelo Cohere (credencial OCI já configurada).
SELECT_AI_PROFILE=

# Opcional: um profile dedicado por agente. Se deixar em branco,
# o agente usa o SELECT_AI_PROFILE acima.
SELECT_AI_PROFILE_CAPACIDADE=
SELECT_AI_PROFILE_PREDICAO=
SELECT_AI_PROFILE_OTIMIZACAO=
